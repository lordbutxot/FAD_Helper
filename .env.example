# Environment Variables Template
# Copy this to .env and fill in your values
# NEVER commit .env to git!

# Secret key for Flask sessions (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here

# Database URL
# For PostgreSQL (production): postgresql://user:password@host:5432/dbname
# For SQLite (development): sqlite:///fad_lists.db
DATABASE_URL=sqlite:///fad_lists.db

# Flask environment
FLASK_ENV=production
FLASK_DEBUG=False

# Application URL (for production)
APP_URL=https://your-app-name.render.com
